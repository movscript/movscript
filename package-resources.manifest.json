{
  "schema": "movscript.package-resources.v1",
  "product": "movscript-desktop",
  "distributionProfile": "default-local",
  "owner": "release-engineering",
  "builderConfig": "apps/desktop/electron-builder.yml",
  "packageFiles": [
    "out/**",
    "package.json",
    "!node_modules/@movscript/**/*.d.ts",
    "!node_modules/@movscript/**/*.d.ts.map",
    "!node_modules/@movscript/**/*.tsbuildinfo",
    "!node_modules/@movscript/mova*/vendor/**/bin/mova*"
  ],
  "resources": [
    {
      "id": "app-icon",
      "category": "static-asset",
      "from": "../../assets/logo.png",
      "to": "logo.png",
      "source": "repository",
      "required": true,
      "owner": "desktop-release",
      "license": "Apache-2.0",
      "updatePolicy": "bundled-with-app",
      "verification": [
        "electron-builder extraResources parity"
      ]
    },
    {
      "id": "ffmpeg",
      "category": "third-party-binary",
      "from": "vendor/ffmpeg",
      "to": "ffmpeg",
      "filter": [
        "**/ffmpeg",
        "**/ffmpeg.exe",
        "**/METADATA.json"
      ],
      "source": "downloaded-release-artifact",
      "required": true,
      "owner": "media-runtime",
      "license": "GPL-3.0-or-later",
      "updatePolicy": "bundled-with-app",
      "platforms": ["darwin", "linux", "win32"],
      "arches": ["x64", "arm64"],
      "verification": [
        "download-ffmpeg-static",
        "verifyDesktopFFmpeg",
        "verifyBundledDesktopFFmpeg"
      ]
    },
    {
      "id": "native-macos-tray-helper",
      "category": "managed-binary",
      "from": "build/native/movscript-native-tray",
      "to": "native/movscript-native-tray",
      "source": "build-artifact",
      "required": true,
      "owner": "desktop-release",
      "license": "Apache-2.0",
      "updatePolicy": "bundled-with-app",
      "platforms": ["darwin"],
      "arches": ["x64", "arm64"],
      "verification": [
        "swiftc apps/desktop/native/macTrayStatusItem.swift",
        "electron-builder extraResources parity"
      ]
    },
    {
      "id": "provider-plugin",
      "category": "plugin-bundle",
      "from": "../../plugins/movscript",
      "to": "provider-plugins/movscript",
      "filter": [
        ".provider-plugin/**",
        ".codex-plugin/**",
        ".mcp.json",
        "assets/**",
        "bin/**",
        "manifest.runtime.json",
        "runtime/**",
        "skills/**",
        "README.md"
      ],
      "source": "repository",
      "required": true,
      "owner": "provider-integrations",
      "license": "Apache-2.0",
      "updatePolicy": "bundled-with-app",
      "verification": [
        "check-plugin-distribution --check",
        "pnpm --filter @movscript/plugin-movscript build",
        "prepareProviderPluginResources",
        "verify-package-resources --plugin-zip",
        "electron-builder extraResources parity"
      ]
    },
    {
      "id": "renderer-admin",
      "category": "static-runtime",
      "from": "../../surface/admin/dist",
      "to": "admin",
      "filter": [
        "**/*"
      ],
      "source": "build-artifact",
      "required": true,
      "owner": "admin-frontend",
      "license": "Apache-2.0",
      "updatePolicy": "bundled-with-app",
      "verification": [
        "pnpm --filter @movscript/admin-surface build",
        "verifyDesktopPackage requiredPaths"
      ]
    },
    {
      "id": "tray-icon",
      "category": "static-asset",
      "from": "../../assets/trayTemplate.png",
      "to": "trayTemplate.png",
      "source": "repository",
      "required": true,
      "owner": "desktop-release",
      "license": "Apache-2.0",
      "updatePolicy": "bundled-with-app",
      "platforms": ["darwin"],
      "verification": [
        "electron-builder extraResources parity"
      ]
    },
    {
      "id": "tray-icon-retina",
      "category": "static-asset",
      "from": "../../assets/trayTemplate@2x.png",
      "to": "trayTemplate@2x.png",
      "source": "repository",
      "required": true,
      "owner": "desktop-release",
      "license": "Apache-2.0",
      "updatePolicy": "bundled-with-app",
      "platforms": ["darwin"],
      "verification": [
        "electron-builder extraResources parity"
      ]
    }
  ],
  "forbiddenPackagePaths": [
    ".git/**",
    ".build/**",
    ".movscript-dev/**",
    "sdk-runtimes/**",
    "node_modules/**",
    "apps/desktop/release/**",
    "services/data-service/vendor/**",
    "tests/**"
  ]
}
