{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://movscript.dev/schemas/model-registry-lab.json",
  "title": "MovScript model registry lab file",
  "type": "object",
  "required": ["lab", "templates"],
  "additionalProperties": false,
  "properties": {
    "lab": {
      "type": "string",
      "minLength": 1
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "lab",
          "model_id",
          "display_name",
          "capabilities",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "lab": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "route_adapter_hint": {
            "description": "Optional bootstrap hint for registry generation only. Runtime adapter selection must come from route templates or route bindings.",
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "allow_model_id_override": {
            "type": "boolean"
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "accepts_image": {
                "type": "boolean"
              },
              "max_images": {
                "type": "integer"
              },
              "max_videos": {
                "type": "integer"
              }
            }
          },
          "input_image_field": {
            "type": "string"
          },
          "video": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "default_duration_sec": {
                "type": "integer"
              },
              "max_duration_sec": {
                "type": "integer"
              }
            }
          },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "type"],
              "properties": {
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "default": true,
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "step": {
                  "type": "number"
                },
                "json_schema": {
                  "type": "object"
                },
                "conflicts_with": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "conditional_enum": {
                  "type": "array"
                },
                "conditional_const": {
                  "type": "array"
                },
                "requires_value": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            }
          },
          "source": {
            "type": "object",
            "required": ["url", "verified_at", "status"],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "verified_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "status": {
                "enum": ["verified", "needs_review", "deprecated", "unofficial"]
              }
            }
          }
        }
      }
    }
  }
}
