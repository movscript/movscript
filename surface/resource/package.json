      "require": "./dist/resourceMediaComponents.cjs"
    },
    "./resource-auth-media": {
      "types": "./dist/resourceAuthMedia.d.ts",
      "import": "./dist/resourceAuthMedia.js",
      "require": "./dist/resourceAuthMedia.cjs"
