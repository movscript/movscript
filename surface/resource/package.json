    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.4",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.2",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1"
