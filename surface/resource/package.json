      "types": "./dist/resourceMediaViewer.d.ts",
      "import": "./dist/resourceMediaViewer.js",
      "require": "./dist/resourceMediaViewer.cjs"
    },
    "./resource-library-picker": {
      "types": "./dist/resourceLibraryPicker.d.ts",
      "import": "./dist/resourceLibraryPicker.js",
