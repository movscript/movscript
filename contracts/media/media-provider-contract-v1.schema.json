{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://movscript.dev/schemas/media-provider-contract-v1.schema.json",
  "title": "Movscript media provider contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "schemaUrl", "provider", "capabilities"],
  "properties": {
    "schema": { "const": "movscript.media.provider_contract.v1" },
    "schemaVersion": { "const": 1 },
    "schemaUrl": { "const": "https://movscript.dev/schemas/media-provider-contract-v1.schema.json" },
    "provider": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capabilityContract" }
    }
  },
  "$defs": {
    "capabilityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "models"],
      "properties": {
        "capability": {
          "type": "string",
          "enum": ["audio_tts", "audio_transcribe", "subtitle_align", "render_video"]
        },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/modelContract" }
        }
      }
    },
    "modelContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelId", "displayName", "features", "supportedParams"],
      "properties": {
        "modelId": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "streaming",
              "ssml",
              "word_timestamps",
              "phoneme_timestamps",
              "viseme_timestamps",
              "voice_clone",
              "voice_design",
              "multi_speaker",
              "emotion_control",
              "speed_control",
              "pitch_control",
              "forced_alignment",
              "burn_in_subtitles"
            ]
          }
        },
        "supportedLanguages": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 }
        },
        "supportedFormats": {
          "type": "array",
          "items": { "type": "string", "enum": ["mp3", "wav", "aac", "opus", "flac", "pcm", "srt", "vtt", "ass", "json", "mp4", "mov", "webm"] }
        },
        "supportedParams": {
          "type": "array",
          "items": { "$ref": "#/$defs/paramDef" }
        }
      }
    },
    "paramDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "type": { "type": "string", "enum": ["string", "number", "boolean", "select"] },
        "default": {},
        "options": {
          "type": "array",
          "items": { "type": ["string", "number", "boolean"] }
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" }
      }
    }
  }
}
