{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://movscript.dev/schemas/agent-settings-snapshot-v1.schema.json",
  "title": "Agent Settings snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "schemaUrl",
    "exportedAt"
  ],
  "properties": {
    "schema": {
      "const": "movscript.agent.settings.snapshot.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "schemaUrl": {
      "const": "https://movscript.dev/schemas/agent-settings-snapshot-v1.schema.json"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "model": {
      "description": "Model routing values exported for partial import. Import saves Runtime connection state and writes a public model binding into the target config file model field; API keys are intentionally excluded.",
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "platformModelId": { "type": "string", "minLength": 1 },
        "apiKind": {
          "type": "string",
          "enum": ["openai_chat_completions", "openai_responses", "anthropic_messages"]
        },
        "baseURL": { "type": "string" },
        "useForChat": { "type": "boolean" },
        "useForPlanner": { "type": "boolean" }
      }
    },
    "activeConfigFileId": {
      "description": "The config file to activate after import when that config file is present in the snapshot or current catalog.",
      "type": "string",
      "minLength": 1
    },
    "configFiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/configFile" }
    },
    "runtimeLimits": {
      "description": "Runtime budget values exported for partial import. Import writes these values into the target config file limits; they are not global Agent identity.",
      "$ref": "#/$defs/runtimeLimits"
    },
    "skillConfig": {
      "description": "Config-file skill activation export. Import writes enabled choices into the target config file skillIds; Skill instruction editing belongs to the Pack or plugin marketplace surface.",
      "type": "array",
      "items": { "$ref": "#/$defs/skillConfigItem" }
    },
    "toolPermissionOverrides": {
      "description": "Per-config-file tool permission overrides. Import preserves configFileId boundaries instead of applying one global tool permission rule.",
      "type": "array",
      "items": { "$ref": "#/$defs/toolPermissionOverride" }
    }
  },
  "$defs": {
    "configFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "version", "name", "enabledPackIds", "skillIds", "toolGrants"],
      "properties": {
        "schema": { "const": "movscript.agent.config_file.v1" },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "enabledPackIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "skillIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "approvalDefaults": { "$ref": "#/$defs/approvalDefaults" },
        "toolGrants": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolGrantItem" }
        },
        "model": {
          "type": "object",
          "additionalProperties": true,
          "required": ["provider", "modelId"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "modelId": { "type": "string", "minLength": 1 },
            "platformModelId": { "type": "string", "minLength": 1 },
            "routes": { "type": "array" }
          }
        },
        "limits": { "$ref": "#/$defs/runtimeLimits" },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "runtimeLimits": {
      "type": "object",
      "properties": {
        "maxToolCalls": { "type": "number", "minimum": 0 },
        "maxIterations": { "type": "number", "minimum": 0 },
        "executionMode": {
          "type": "string",
          "enum": ["compact", "standard", "deep"]
        },
        "allowForcedToolCalls": { "type": "boolean" },
        "maxActiveTriggeredSkills": { "type": "number", "minimum": 0 },
        "systemPromptCharLimit": { "type": "number", "minimum": 0 },
        "contextWindowCharLimit": { "type": "number", "minimum": 0 },
        "maxRetrievedContextChars": { "type": "number", "minimum": 0 },
        "maxReferenceCharsPerRun": { "type": "number", "minimum": 0 },
        "maxReferenceChunksPerRun": { "type": "number", "minimum": 0 },
        "maxHistoryMessages": { "type": "number", "minimum": 0 },
        "maxThreadSummaryChars": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "approvalDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/$defs/approvalMode" },
        "read": { "$ref": "#/$defs/approvalMode" },
        "draft": { "$ref": "#/$defs/approvalMode" },
        "write": { "$ref": "#/$defs/approvalMode" },
        "generate": { "$ref": "#/$defs/approvalMode" },
        "destructive": { "$ref": "#/$defs/approvalMode" },
        "ui": { "$ref": "#/$defs/approvalMode" }
      }
    },
    "approvalMode": {
      "type": "string",
      "enum": ["never", "always", "on_write"]
    },
    "skillConfigItem": {
      "type": "object",
      "description": "enabled is not a global Skill flag; it represents whether the target config file should include this skill in skillIds.",
      "additionalProperties": false,
      "required": ["id", "enabled"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "enabled": {
          "description": "When imported, true adds the skill id to the target config file skillIds; false removes it unless the skill is core.",
          "type": "boolean"
        }
      }
    },
    "toolPermissionOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configFileId", "toolGrants"],
      "properties": {
        "configFileId": { "type": "string", "minLength": 1 },
        "toolGrants": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolGrantItem" }
        }
      }
    },
    "toolGrantItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["allow", "deny"] },
        "approval": { "$ref": "#/$defs/approvalMode" }
      }
    }
  }
}
