{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://movscript.dev/schemas/agent-run-configuration-snapshot-v1.schema.json",
  "title": "Agent Run configuration snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capturedAt",
    "catalogSnapshot",
    "activeConfigFileId",
    "providerSessionLimits",
    "activeProviderManifest",
    "toolPermissionOverridesByConfigFile",
    "configFiles",
    "packs",
    "skills",
    "tools",
    "pluginCatalog",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "movscript.agent.run-configuration-snapshot.v1"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "catalogSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "activeConfigFileId": {
      "type": "string",
      "minLength": 1,
      "description": "The config file that was active when this Run was created. This is top-level snapshot data so Run details do not need to infer it from mutable Agent settings or manifest metadata."
    },
    "providerSessionLimits": {
      "description": "Frozen provider-session approval, sandbox, execution mode, and budget limits captured when this Run was created.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "approvalMode": { "type": "string" },
        "sandboxMode": { "type": "boolean" },
        "maxToolCalls": { "type": "number" },
        "maxIterations": { "type": "number" },
        "allowNetwork": { "type": "boolean" },
        "allowFileBytes": { "type": "boolean" },
        "execution": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "runtimeLimits": {
      "description": "Compatibility alias for older run configuration snapshots. New snapshots use providerSessionLimits.",
      "type": "object",
      "additionalProperties": true,
      "deprecated": true
    },
    "activeProviderManifest": { "$ref": "#/$defs/providerManifest" },
    "activeAgentManifest": {
      "$ref": "#/$defs/providerManifest",
      "description": "Compatibility alias for older run configuration snapshots. New snapshots use activeProviderManifest.",
      "deprecated": true
    },
    "toolPermissionOverridesByConfigFile": {
      "type": "object",
      "description": "Frozen per-config-file tool permission overrides captured at Run creation time. Run details should read this top-level snapshot fact instead of inferring overrides from mutable settings or manifest metadata.",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/toolGrant" }
      }
    },
    "configFiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/configFile" }
    },
    "packs": {
      "type": "array",
      "items": { "$ref": "#/$defs/pack" }
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    },
    "pluginCatalog": {
      "description": "Frozen plugin/catalog source metadata captured when this Run was created. Null means the runtime explicitly had no plugin catalog info available at capture time.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "providerManifest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema", "id", "version", "name", "tools"],
      "properties": {
        "schema": { "const": "movscript.agent.current" },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolGrant" }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "enabled": { "type": "boolean" }
            }
          }
        },
        "model": {
          "$ref": "#/$defs/modelBinding"
        },
        "metadata": {
          "type": "object",
          "description": "Frozen manifest metadata captured at Run creation time. Run details should prefer canonical top-level snapshot fields such as activeConfigFileId and toolPermissionOverridesByConfigFile instead of inferring facts from this metadata.",
          "additionalProperties": true
        }
      }
    },
    "configFile": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema", "id", "version", "name", "enabledPackIds", "skillIds", "toolGrants"],
      "properties": {
        "schema": { "const": "movscript.agent.config_file.v1" },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "enabledPackIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "skillIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "approvalDefaults": { "$ref": "#/$defs/approvalDefaults" },
        "toolGrants": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolGrant" }
        },
        "model": {
          "$ref": "#/$defs/modelBinding"
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxToolCalls": { "type": "number" },
            "maxIterations": { "type": "number" },
            "executionMode": {
              "type": "string",
              "enum": ["compact", "standard", "deep"]
            },
            "allowForcedToolCalls": { "type": "boolean" },
            "maxActiveTriggeredSkills": { "type": "number" },
            "systemPromptCharLimit": { "type": "number" },
            "contextWindowCharLimit": { "type": "number" },
            "maxRetrievedContextChars": { "type": "number" },
            "maxReferenceCharsPerRun": { "type": "number" },
            "maxReferenceChunksPerRun": { "type": "number" },
            "maxHistoryMessages": { "type": "number" },
            "maxThreadSummaryChars": { "type": "number" }
          },
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "modelBinding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider", "modelId"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "platformModelId": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "number" }
          ]
        },
        "routes": {
          "type": "array",
          "items": {}
        }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "version", "name", "source", "schemas", "tools", "skills"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "schemas": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reference": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requires": {
          "type": "object",
          "additionalProperties": true
        },
        "conflicts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "description", "enabled", "instructionTemplate"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "enabled": { "type": "boolean" },
        "priority": { "type": "number" },
        "instructionTemplate": { "type": "string" },
        "loadMode": { "type": "string", "enum": ["core", "on_demand", "manual"] },
        "source": { "type": "string" },
        "activationScope": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "triggers": {
          "type": "array",
          "items": {}
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "conflicts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "toolGrants": {
          "description": "Canonical tool names this Skill can grant when loaded.",
          "type": "array",
          "items": { "type": "string" }
        },
        "schemaRefs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contextBudget": {
          "type": "object",
          "additionalProperties": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "description", "permission", "risk", "defaults", "projectScoped"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "permission": { "type": "string" },
        "risk": { "type": "string" },
        "source": { "type": "string" },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grant", "approval"],
          "properties": {
            "grant": { "type": "string", "enum": ["allow", "deny"] },
            "approval": { "$ref": "#/$defs/approvalMode" },
            "timeoutMs": { "type": "number" }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": true
        },
        "projectScoped": { "type": "boolean" },
        "requiresSkills": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "toolGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["allow", "deny"] },
        "approval": { "$ref": "#/$defs/approvalMode" }
      }
    },
    "approvalDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/$defs/approvalMode" },
        "read": { "$ref": "#/$defs/approvalMode" },
        "workspace": { "$ref": "#/$defs/approvalMode" },
        "write": { "$ref": "#/$defs/approvalMode" },
        "generate": { "$ref": "#/$defs/approvalMode" },
        "destructive": { "$ref": "#/$defs/approvalMode" },
        "ui": { "$ref": "#/$defs/approvalMode" }
      }
    },
    "approvalMode": {
      "type": "string",
      "enum": ["never", "always", "on_write"]
    }
  }
}
