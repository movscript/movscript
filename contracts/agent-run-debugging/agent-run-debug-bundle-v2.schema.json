{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://movscript.dev/schemas/agent-run-debug-bundle-v2.schema.json",
  "title": "AgentRun debug bundle v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "schemaUrl",
    "generatedAt",
    "capabilities",
    "runId",
    "run",
    "runSummary",
    "trace",
    "fieldGuide",
    "coverage",
    "readinessChecklist",
    "runtimeSummary",
    "runtimeFrames",
    "attentionEvents",
    "pendingActions",
    "events"
  ],
  "properties": {
    "schema": { "const": "movscript.agent-run-debug-bundle.v2" },
    "schemaUrl": { "const": "https://movscript.dev/schemas/agent-run-debug-bundle-v2.schema.json" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "runSummary",
          "readinessChecklist",
          "runtimeSummary",
          "runtimeFrames",
          "fullDebugEvents",
          "fullContextDiffs",
          "fullPromptPayloads",
          "attentionEvents",
          "pendingActions",
          "fieldGuide",
          "redactedDebugData"
        ]
      },
      "contains": { "const": "runtimeFrames" },
      "uniqueItems": true
    },
    "runId": { "type": "string", "minLength": 1 },
    "run": { "type": "object" },
    "runSummary": { "type": "object" },
    "trace": {
      "type": "object",
      "required": ["loaded", "hasMore"],
      "properties": {
        "loaded": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "hasMore": { "type": "boolean" }
      }
    },
    "fieldGuide": { "type": "array", "items": { "type": "object" } },
    "coverage": { "type": "object" },
    "readinessChecklist": { "type": "array", "items": { "type": "object" } },
    "runtimeSummary": { "type": "object" },
    "runtimeFrames": {
      "type": "array",
      "items": { "$ref": "#/$defs/runtimeFrame" }
    },
    "attentionEvents": { "type": "array", "items": { "type": "object" } },
    "pendingActions": { "type": "array", "items": { "type": "object" } },
    "events": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "runtimeFrame": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "kind",
        "label",
        "startedAt",
        "status",
        "focus",
        "eventIds",
        "events",
        "attentionEvents"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["setup", "round", "finalize"] },
        "label": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["started", "completed", "blocked", "failed", "info"] },
        "focus": {
          "type": "array",
          "items": { "type": "string", "enum": ["context", "model", "tool", "skill", "message", "approval", "attention", "raw"] },
          "uniqueItems": true
        },
        "eventIds": { "type": "array", "items": { "type": "string" } },
        "events": { "type": "array", "items": { "type": "object" } },
        "context": {
          "type": "object",
          "properties": {
            "diff": { "$ref": "#/$defs/contextDiff" }
          }
        }
      }
    },
    "contextDiff": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mutationCount",
        "appended",
        "amended",
        "deleted",
        "affectedContextKeys",
        "appendedContextKeys",
        "amendedContextKeys",
        "deletedContextKeys",
        "mutationEventIds",
        "changes",
        "mutations"
      ],
      "properties": {
        "mutationCount": { "type": "integer", "minimum": 0 },
        "appended": { "type": "integer", "minimum": 0 },
        "amended": { "type": "integer", "minimum": 0 },
        "deleted": { "type": "integer", "minimum": 0 },
        "affectedContextKeys": { "type": "array", "items": { "type": "string" } },
        "appendedContextKeys": { "type": "array", "items": { "type": "string" } },
        "amendedContextKeys": { "type": "array", "items": { "type": "string" } },
        "deletedContextKeys": { "type": "array", "items": { "type": "string" } },
        "mutationEventIds": { "type": "array", "items": { "type": "string" } },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["eventId", "op", "key"],
            "properties": {
              "eventId": { "type": "string" },
              "op": { "type": "string", "enum": ["append", "amend", "delete", "unknown"] },
              "key": { "type": "string" }
            }
          }
        },
        "mutations": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
