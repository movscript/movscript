{
  "name": "@movscript/core",
  "version": "0.1.20",
  "description": "MovScript domain core shared by CLI, frontend, and provider adapters.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js",
      "require": "./dist/workspace/index.cjs"
    },
    "./workspace/node": {
      "types": "./dist/workspace/node/index.d.ts",
      "import": "./dist/workspace/node/index.js",
      "require": "./dist/workspace/node/index.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.cjs"
    },
    "./mcp/node": {
      "types": "./dist/mcp/node/index.d.ts",
      "import": "./dist/mcp/node/index.js",
      "require": "./dist/mcp/node/index.cjs"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js",
      "require": "./dist/backend/index.cjs"
    },
    "./backend/node": {
      "types": "./dist/backend/node/index.d.ts",
      "import": "./dist/backend/node/index.js",
      "require": "./dist/backend/node/index.cjs"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "import": "./dist/canvas/index.js",
      "require": "./dist/canvas/index.cjs"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "import": "./dist/content/index.js",
      "require": "./dist/content/index.cjs"
    },
    "./generation": {
      "types": "./dist/generation/index.d.ts",
      "import": "./dist/generation/index.js",
      "require": "./dist/generation/index.cjs"
    },
    "./production": {
      "types": "./dist/production/index.d.ts",
      "import": "./dist/production/index.js",
      "require": "./dist/production/index.cjs"
    },
    "./resources": {
      "types": "./dist/resources/index.d.ts",
      "import": "./dist/resources/index.js",
      "require": "./dist/resources/index.cjs"
    },
    "./shot-library": {
      "types": "./dist/shot-library/index.d.ts",
      "import": "./dist/shot-library/index.js",
      "require": "./dist/shot-library/index.cjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.cjs"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js",
      "require": "./dist/agent/index.cjs"
    },
    "./agent/chat": {
      "types": "./dist/agent/chat/index.d.ts",
      "import": "./dist/agent/chat/index.js",
      "require": "./dist/agent/chat/index.cjs"
    },
    "./agent/protocol": {
      "types": "./dist/agent/protocol.d.ts",
      "import": "./dist/agent/protocol.js",
      "require": "./dist/agent/protocol.cjs"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js",
      "require": "./dist/plugins/index.cjs"
    },
    "./plugins/node": {
      "types": "./dist/plugins/node/index.d.ts",
      "import": "./dist/plugins/node/index.js",
      "require": "./dist/plugins/node/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@movscript/editing": "workspace:*",
    "@movscript/interpreter": "workspace:*",
    "@movscript/engine": "workspace:*",
    "@movscript/language": "workspace:*",
    "@movscript/workspace": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
