{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@movscript/agent-chat": ["../agent-chat/src/index.ts"],
      "@movscript/agent-protocol": ["../agent-protocol/src/index.ts"],
      "@movscript/decision": ["../decision/src/index.ts"],
      "@movscript/editing": ["../editing/src/index.ts"],
