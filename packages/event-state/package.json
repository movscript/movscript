{
  "name": "@movscript/event-state",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared helpers for MovScript runtime event extraction.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "node ../../scripts/run-node-tests.mjs \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@movscript/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0"
  }
}
