{
  "name": "@movscript/engine",
  "version": "0.1.27",
  "private": true,
  "description": "Embeddable MovScript facade for workspace diagnostics, interpret refresh, stores, and candidate workflows.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build"
  },
  "dependencies": {
    "@movscript/interpreter": "workspace:*",
    "@movscript/prompt": "workspace:*",
    "@movscript/workspace": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
