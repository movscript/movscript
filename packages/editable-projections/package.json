{
  "name": "@movscript/editable-projections",
  "version": "0.1.0",
  "description": "Framework for database-backed editable file projections with reviewable apply plans.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "editable-projections",
    "file-workspace",
    "local-first",
    "projection",
    "review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/movscript/movscript.git",
    "directory": "packages/editable-projections"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./examples/note": {
      "types": "./dist/examples/note.d.ts",
      "import": "./dist/examples/note.js",
      "require": "./dist/examples/note.cjs"
    },
    "./examples/movscript-asset-slot": {
      "types": "./dist/examples/movscriptAssetSlot.d.ts",
      "import": "./dist/examples/movscriptAssetSlot.js",
      "require": "./dist/examples/movscriptAssetSlot.cjs"
    },
    "./examples/movscript-project": {
      "types": "./dist/examples/movscriptProject.d.ts",
      "import": "./dist/examples/movscriptProject.js",
      "require": "./dist/examples/movscriptProject.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/node.ts src/testing.ts src/examples/note.ts src/examples/movscriptAssetSlot.ts src/examples/movscriptProject.ts --format esm,cjs --dts --clean",
    "prepack": "npm run build",
    "pack:check": "node tests/pack-check.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "tsc --noEmit -p tsconfig.consumer.json",
    "test": "pnpm build && pnpm typecheck:consumer && pnpm pack:check && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0"
  }
}
