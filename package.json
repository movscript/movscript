{
  "name": "movscript",
  "version": "0.1.43",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "check": "pnpm run check:generated-paths && pnpm run check:workspace-packages && pnpm run check:plugin-distribution && pnpm run runtime:registry && pnpm run test:scripts && pnpm run typecheck && pnpm run build && pnpm run test && pnpm run quality:ui && pnpm run quality:frontend && pnpm run verify:package-resources",
    "check:generated-paths": "node scripts/check-generated-paths.mjs",
    "check:workspace-packages": "node scripts/check-workspace-packages.mjs",
    "check:plugin-distribution": "node scripts/check-plugin-distribution.mjs --check",
    "check:backend": "pnpm --filter @movscript/data-service run test:unit && pnpm --filter @movscript/data-service run test:model-capability-contract",
    "build": "pnpm run build:workspace && pnpm run sync:plugin-distribution",
    "build:workspace": "pnpm -r --if-present build",
    "build:packages": "pnpm -r --filter \"./packages/*\" --if-present build",
    "build:surface": "pnpm -r --filter \"./surface/*\" --if-present build",
    "build:apps": "pnpm -r --filter \"./apps/*\" --if-present build",
    "build:services": "pnpm -r --filter \"./services/*\" --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:packages && pnpm --filter @movscript/desktop test",
    "test:packages": "pnpm -r --filter \"./surface/*\" --if-present test && pnpm -r --filter \"./packages/*\" --if-present test",
    "test:scripts": "node scripts/run-node-tests.mjs --suite scripts",
    "clean": "pnpm run clean:build && pnpm run clean:stage",
    "clean:build": "node scripts/clean-generated.mjs --build",
    "clean:stage": "node scripts/clean-generated.mjs --stage",
    "clean:release": "node scripts/clean-generated.mjs --release",
    "clean:cache": "node scripts/clean-generated.mjs --cache",
    "clean:dev-state": "node scripts/clean-generated.mjs --dev-state",
    "clean:vendor-runtime": "node scripts/clean-generated.mjs --vendor-runtime",
    "sync:plugin-distribution": "node scripts/check-plugin-distribution.mjs --write",
    "dev:sdk-runtimes": "pnpm --filter @movscript/desktop dev:sdk-runtimes",
    "quality:ui": "node scripts/check-ui-package-quality.mjs --check",
    "ui:audit": "node scripts/check-ui-package-quality.mjs",
    "quality:frontend": "node apps/desktop/scripts/check-frontend-quality.mjs --check",
    "frontend:audit": "node apps/desktop/scripts/check-frontend-quality.mjs",
    "frontend:contracts": "pnpm quality:frontend && node scripts/run-node-tests.mjs --suite frontend-contracts",
    "frontend:state-consistency": "pnpm --filter @movscript/core build && node scripts/run-node-tests.mjs --suite frontend-state-consistency",
    "benchmark:project-service": "node scripts/benchmark-project-service-performance.mjs",
    "prepare:sdk-runtimes": "node scripts/prepare-sdk-runtime-seed.mjs",
    "smoke:sdk-runtimes": "node scripts/smoke-sdk-runtimes.mjs",
    "verify:package-resources": "node scripts/release/verify-package-resources.mjs",
    "package:mac:dmg": "node scripts/release/package-macos-local-dmg.mjs",
    "release:check": "pnpm run release -- check",
    "release:dry-run": "pnpm run release -- dry-run --unsigned",
    "release:package:unsigned": "pnpm run release -- package --app desktop --unsigned",
    "release:package:signed": "pnpm run release -- package --app desktop --signed",
    "release:package:plugin": "pnpm run release -- package --app plugin",
    "runtime:registry": "node tools/runtime-registry.mjs --check",
    "movscript-lang:local": "node scripts/movscript-lang-cwd.mjs --cwd ../movscript-lang",
    "movscript-lang:link": "node scripts/movscript-lang-deps.mjs local --path ../movscript-lang",
    "movscript-lang:latest": "node scripts/movscript-lang-deps.mjs latest",
    "movscript-lang:version": "node scripts/movscript-lang-deps.mjs version",
    "release": "node scripts/release/release-workflow.mjs"
  },
  "testSuites": {
    "frontend-contracts": [
      "tests/scripts/frontend/*.test.mjs"
    ],
    "frontend-state-consistency": [
      "packages/core/tests/content.test.mjs",
      "tests/scripts/frontend/*.test.mjs"
    ],
    "scripts": [
      "tests/scripts/**/*.test.mjs"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "electron-builder-squirrel-windows"
      ]
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty",
      "sharp"
    ]
  }
}
