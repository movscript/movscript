{
  "name": "movscript",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --if-present build && pnpm --filter @movscript/cli build && pnpm -r --filter \"./apps/*\" --filter \"!@movscript/cli\" --if-present build && pnpm -r --filter \"./plugins/*\" --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:packages && pnpm --filter @movscript/desktop test && pnpm --filter @movscript/admin test",
    "test:packages": "pnpm -r --filter \"./packages/*\" --if-present test",
    "test:scripts": "node scripts/run-node-tests.mjs --suite scripts",
    "app-server:install-plugin": "node scripts/install-app-server-plugin.mjs",
    "sync:app-server-protocol": "node scripts/sync-app-server-protocol.mjs",
    "movscript-lang:local": "node scripts/movscript-lang-cwd.mjs --cwd ../movscript-lang",
    "movscript-lang:latest": "node scripts/movscript-lang-deps.mjs latest",
    "movscript-lang:version": "node scripts/movscript-lang-deps.mjs version",
    "release": "node scripts/release/release-workflow.mjs"
  },
  "testSuites": {
    "scripts": [
      "tests/scripts/app-server-entrypoints.test.mjs",
      "tests/scripts/run-node-tests.test.mjs",
      "tests/scripts/run-with-env.test.mjs",
      "tests/scripts/movscript-lang-deps.test.mjs",
      "tests/scripts/verifier-utils.test.mjs",
      "tests/scripts/backend/*.test.mjs",
      "tests/scripts/frontend/*.test.mjs",
      "tests/scripts/release/audit-ffmpeg.test.mjs",
      "tests/scripts/release/collect-artifacts.test.mjs",
      "tests/scripts/release/desktop-package-verification.test.mjs",
      "tests/scripts/release/download-ffmpeg-static.test.mjs",
      "tests/scripts/release/package-desktop-prepare.test.mjs",
      "tests/scripts/release/package-desktop.test.mjs",
      "tests/scripts/release/release-workflow-cli.test.mjs",
      "tests/scripts/release/release-workflow.test.mjs",
      "tests/scripts/release/stage-app-server-binaries.test.mjs",
      "tests/scripts/release/stage-ffmpeg.test.mjs"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp"
    ]
  }
}
