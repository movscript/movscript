# Docker builds currently use the repository root as context, but the
# data-service image only needs the Go service tree and its vendored deps.
*

!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!.npmrc

!services/
services/*
!services/auth-service/
!services/auth-service/**
!services/data-service/
!services/data-service/**

!packages/
packages/*
!packages/runtime-contracts/
!packages/runtime-contracts/**

# Generated paths and local state. Keep this list aligned with
# tools/generated-paths.mjs and scripts/check-generated-paths.mjs.
.git/
.gocache
.gomodcache
.movscript-dev/
.pnpm-store/
.venv/
*.tsbuildinfo
apps/*/dist/
apps/desktop/.package-stage/
apps/desktop/dist-electron/
apps/desktop/out/
apps/desktop/release/
downloaded-artifacts/
node_modules/
packages/*/dist/
plugins/*/release/
release-artifacts/
services/*/dist/
services/auth-service/bin/
services/data-service/.cache/
services/data-service/.gocache/
services/data-service/bin/
services/data-service/main
services/data-service/uploads/
surface/*/dist/

# Local and editor files.
.env
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
