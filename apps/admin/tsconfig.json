{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@movscript/core/workspace": [
        "../../packages/core/src/workspace/index.ts"
      ],
      "@movscript/core/mcp": [
        "../../packages/core/src/mcp/index.ts"
      ],
      "@movscript/core/backend": [
        "../../packages/core/src/backend/index.ts"
      ],
      "@movscript/core/plugins": [
        "../../packages/core/src/plugins/index.ts"
      ],
      "@movscript/decision": [
        "../../packages/decision/src/index.ts"
      ],
      "@movscript/editing": [
        "../../packages/editing/src/index.ts"
      ],
      "@movscript/engine": [
        "../../packages/engine/src/index.ts"
      ],
      "@movscript/engine/node": [
        "../../packages/engine/src/node.ts"
      ],
      "@movscript/interpreter": [
        "../../packages/interpreter/src/index.ts"
      ],
      "@movscript/interpreter/artifacts": [
        "../../packages/interpreter/src/artifacts/index.ts"
      ],
      "@movscript/interpreter/node": [
        "../../packages/interpreter/src/node.ts"
      ],
      "@movscript/language": [
        "../../packages/language/src/index.ts"
      ],
      "@movscript/language/domain": [
        "../../packages/language/src/domain/index.ts"
      ],
      "@movscript/prompt": [
        "../../packages/prompt/src/index.ts"
      ],
      "@movscript/theme": [
        "../../packages/theme/src/index.ts"
      ],
      "@movscript/ui/style-system": [
        "../../packages/ui/src/style-system.ts"
      ],
      "@movscript/ui/primitives": [
        "../../packages/ui/src/primitives.ts"
      ],
      "@movscript/ui/layout": [
        "../../packages/ui/src/layout.ts"
      ],
      "@movscript/ui/debug": [
        "../../packages/ui/src/debug-entry.ts"
      ],
      "@movscript/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@movscript/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@movscript/workspace": [
        "../../packages/workspace/src/index.ts"
      ],
      "@movscript/workspace/indexer": [
        "../../packages/workspace/src/indexer/index.ts"
      ],
      "@movscript/workspace/layout": [
        "../../packages/workspace/src/layout/index.ts"
      ],
      "@movscript/workspace/node": [
        "../../packages/workspace/src/node.ts"
      ],
      "@movscript/workspace/repository": [
        "../../packages/workspace/src/repository/index.ts"
      ],
      "@/*": [
        "./src/*"
      ],
      "@admin/*": [
        "./src/*"
      ],
      "@admin-runtime": [
        "./src/runtime/community.tsx"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
