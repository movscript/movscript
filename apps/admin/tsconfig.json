{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@movscript/core/workspace": [
        "../../packages/core/src/workspace/index.ts"
      ],
      "@movscript/core/mcp": [
        "../../packages/core/src/mcp/index.ts"
      ],
      "@movscript/core/backend": [
        "../../packages/core/src/backend/index.ts"
      ],
      "@movscript/core/plugins": [
        "../../packages/core/src/plugins/index.ts"
      ],
      "@movscript/theme": [
        "../../packages/theme/src/index.ts"
      ],
      "@movscript/ui/style-system": [
        "../../packages/ui/src/style-system.ts"
      ],
      "@movscript/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@/*": [
        "./src/*"
      ],
      "@admin/*": [
        "./src/*"
      ],
      "@admin-runtime": [
        "./src/runtime/community.tsx"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
