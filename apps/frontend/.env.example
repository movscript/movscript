VITE_API_BASE_URL=http://localhost:8765
# Optional local agent runtime transport for the renderer.
# http keeps direct loopback fetches. electron proxies through Electron main.
# unix-socket proxies through Electron main and requires VITE_LOCAL_AGENT_SOCKET_PATH.
VITE_LOCAL_AGENT_TRANSPORT=http
# VITE_LOCAL_AGENT_SOCKET_PATH=/tmp/movscript-agent.sock
