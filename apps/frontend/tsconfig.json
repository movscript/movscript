{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@movscript/editable-projections": ["../../packages/editable-projections/src/index.ts"],
      "@movscript/editable-projections/node": ["../../packages/editable-projections/src/node.ts"],
      "@movscript/editable-projections/testing": ["../../packages/editable-projections/src/testing.ts"],
      "@movscript/editable-projections/examples/note": ["../../packages/editable-projections/src/examples/note.ts"],
      "@movscript/editable-projections/examples/movscript-asset-slot": ["../../packages/editable-projections/src/examples/movscriptAssetSlot.ts"],
      "@movscript/editable-projections/examples/movscript-project": ["../../packages/editable-projections/src/examples/movscriptProject.ts"],
      "@movscript/workspaces/node": ["../../packages/workspaces/src/node.ts"],
      "@movscript/workspaces": ["../../packages/workspaces/src/index.ts"],
      "@movscript/theme": ["../../packages/theme/src/index.ts"],
      "@movscript/ui/style-system": ["../../packages/ui/src/style-system.ts"],
      "@movscript/ui": ["../../packages/ui/src/index.ts"],
      "@movscript/ui/*": ["../../packages/ui/src/*"],
      "@runtime": ["./src/runtime/community.tsx"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "electron"]
}
