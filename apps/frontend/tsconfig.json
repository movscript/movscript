{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@movscript/core/workspace": [
        "../../packages/core/src/workspace/index.ts"
      ],
      "@movscript/core/mcp": [
        "../../packages/core/src/mcp/index.ts"
      ],
      "@movscript/core/backend": [
        "../../packages/core/src/backend/index.ts"
      ],
      "@movscript/core/canvas": [
        "../../packages/core/src/canvas/index.ts"
      ],
      "@movscript/core/content": [
        "../../packages/core/src/content/index.ts"
      ],
      "@movscript/core/generation": [
        "../../packages/core/src/generation/index.ts"
      ],
      "@movscript/core/production": [
        "../../packages/core/src/production/index.ts"
      ],
      "@movscript/core/resources": [
        "../../packages/core/src/resources/index.ts"
      ],
      "@movscript/core/shot-library": [
        "../../packages/core/src/shot-library/index.ts"
      ],
      "@movscript/core/shared": [
        "../../packages/core/src/shared/index.ts"
      ],
      "@movscript/core/agent": [
        "../../packages/core/src/agent/index.ts"
      ],
      "@movscript/core/agent/chat": [
        "../../packages/core/src/agent/chat/index.ts"
      ],
      "@movscript/core/agent/protocol": [
        "../../packages/core/src/agent/protocol.ts"
      ],
      "@movscript/core/plugins": [
        "../../packages/core/src/plugins/index.ts"
      ],
      "@movscript/theme": [
        "../../packages/theme/src/index.ts"
      ],
      "@movscript/ui/style-system": [
        "../../packages/ui/src/style-system.ts"
      ],
      "@movscript/ui/semantic": [
        "../../packages/ui/src/semantic.ts"
      ],
      "@movscript/ui/primitives": [
        "../../packages/ui/src/primitives.ts"
      ],
      "@movscript/ui/layout": [
        "../../packages/ui/src/layout.ts"
      ],
      "@movscript/ui/debug": [
        "../../packages/ui/src/debug-entry.ts"
      ],
      "@movscript/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@movscript/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@runtime": [
        "./src/runtime/community.tsx"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/e2e"
  ]
