DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=movscript
DB_DRIVER=postgres
DB_PATH=

SERVER_PORT=8765
MOVSCRIPT_APP_MODE=cloud
MOVSCRIPT_DATA_DIR=

# Dependency profile: custom keeps explicit env values, local uses local simulators,
# external uses managed/external services.
# local: sqlite, filesystem, git HTTP backend, local AI gateway, memory cache
# external: postgres, minio, gitea, new-api, redis
MOVSCRIPT_DEPENDENCY_PROFILE=external

# Required. Generate with:
# openssl rand -hex 32
ENCRYPTION_KEY=

# Required. Generate independently from ENCRYPTION_KEY:
# openssl rand -hex 32
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_HOURS=24

# Optional. When set, /mcp requires Authorization: Bearer <MCP_TOKEN>.
MCP_TOKEN=

# Object storage: minio or filesystem.
STORAGE_BACKEND=minio

# Used when STORAGE_BACKEND=filesystem. Defaults to $MOVSCRIPT_DATA_DIR/resources.
FILESYSTEM_STORAGE_ROOT=

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=movscript
MINIO_USE_SSL=false

# Server-side workspace storage. Frontend/CLI still use the MovScript HTTP API.
# gitea for external Git service, http for local git-http-backend simulation.
MOVSCRIPT_WORKSPACE_STORAGE_BACKEND=gitea
# Used when MOVSCRIPT_WORKSPACE_STORAGE_BACKEND=http. Defaults to MOVSCRIPT_DATA_DIR/git.
MOVSCRIPT_GIT_HTTP_ROOT=
MOVSCRIPT_GIT_BINARY=git
MOVSCRIPT_GITEA_BASE_URL=http://localhost:3003
# Required when MOVSCRIPT_WORKSPACE_STORAGE_BACKEND=gitea unless MOVSCRIPT_GITEA_ADMIN_USERNAME/PASSWORD are set.
MOVSCRIPT_GITEA_TOKEN=
MOVSCRIPT_GITEA_ADMIN_USERNAME=
MOVSCRIPT_GITEA_ADMIN_PASSWORD=
# Personal projects route to the MovScript username; team projects route to
# MOVSCRIPT_GITEA_ORG_PREFIX + org slug.
MOVSCRIPT_GITEA_ORG_PREFIX=movscript-org-
MOVSCRIPT_GITEA_REPO_PREFIX=movscript-project-
MOVSCRIPT_GITEA_BRANCH=main
MOVSCRIPT_GITEA_USER_EMAIL_DOMAIN=users.movscript.local
MOVSCRIPT_GITEA_USER_TOKEN_NAME=movscript-desktop

# AI gateway provider: new-api for external gateway, local for backend-local gateway.
MOVSCRIPT_AI_GATEWAY_PROVIDER=new-api

GITEA_HTTP_PORT=3003
GITEA_SSH_PORT=2222
GITEA_ROOT_URL=http://localhost:3003/
GITEA_DISABLE_REGISTRATION=true
