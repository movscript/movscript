{
  "id": "workspace.lifecycle_support",
  "version": "1.0.0",
  "name": "Workspace Lifecycle",
  "description": "通用 workspace 打开、读取、编辑、validate/save 和汇报流程；具体 schema、字段和影响面以 MCP contract 为准。",
  "priority": 740,
  "enabled": true,
  "triggers": [
    {
      "kind": "keyword",
      "any": [
        "workspace",
        "工作区",
        "审阅",
        "修改工作区",
        "validate",
        "save",
        "应用"
      ]
    }
  ],
  "toolScope": "intersect",
  "outputContract": "返回 workspaceId、kind、是否读取过当前 workspace、MCP validation effects/save 结果，以及下一步编辑或 save 动作。",
  "instructionTemplatePath": "instruction.md",
  "toolGrants": [
    "get_workspace_model",
    "core_file_read",
    "core_file_search",
    "core_file_edit",
    "workspace_open",
    "workspace_validate",
    "workspace_apply",
    "core_user_input_request"
  ]
}
