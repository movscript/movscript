{
  "id": "core.workflow.subagent_planning",
  "kind": "workflow",
  "version": "1.0.0",
  "name": "Planner Subagents",
  "description": "在 planner run 中为可并行或可隔离的任务启动、观察和综合 subagent runs。",
  "priority": 760,
  "enabled": true,
  "triggers": [
    { "kind": "intent", "id": "planner_subagents" },
    {
      "kind": "keyword",
      "any": [
        "subagent",
        "worker",
        "parallel",
        "并行",
        "子代理",
        "多任务",
        "拆分任务",
        "分工"
      ]
    }
  ],
  "toolRefs": [
    "tool://core_subagent_spawn",
    "tool://core_subagent_list",
    "tool://core_subagent_wait",
    "tool://core_subagent_cancel",
    "tool://core_user_input_request"
  ],
  "toolScope": "intersect",
  "outputContract": "返回 planner 自己完成的内容、已启动或等待的 subagent 名称、run 状态、阻塞项和最终综合结论。",
  "instructionTemplatePath": "instruction.md"
}
