{
  "id": "core.subagent_planning",
  "version": "1.0.0",
  "name": "Planner Subagents",
  "description": "在 planner run 中按用户授意或为确需并行、隔离、长时等待的计划步骤启动、观察和综合 subagent runs。",
  "priority": 760,
  "enabled": true,
  "triggers": [
    {
      "kind": "intent",
      "id": "planner_subagents"
    },
    {
      "kind": "keyword",
      "any": [
        "subagent",
        "worker",
        "parallel",
        "并行",
        "子 agent",
        "分工"
      ]
    }
  ],
  "toolScope": "intersect",
  "outputContract": "返回当前计划状态、planner 自己完成的内容、已启动或等待的 subagent 名称、run 状态、阻塞项和最终综合结论。",
  "instructionTemplatePath": "instruction.md",
  "toolGrants": [
    "core_work_start",
    "core_work_get",
    "core_work_list",
    "core_work_wait",
    "core_work_cancel",
    "core_user_input_request"
  ]
}
