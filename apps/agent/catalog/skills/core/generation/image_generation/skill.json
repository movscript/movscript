{
  "id": "core.generation.image",
  "version": "1.0.0",
  "name": "Image Generation",
  "description": "Plan, submit, and observe image generation through the agent-owned generation provider interface.",
  "priority": 740,
  "enabled": true,
  "triggers": [
    {
      "kind": "intent",
      "id": "image_generation"
    },
    {
      "kind": "keyword",
      "any": [
        "图像生成",
        "文生图",
        "图生图",
        "出图",
        "generate image",
        "image generation",
        "text to image",
        "image edit"
      ]
    }
  ],
  "toolScope": "intersect",
  "outputContract": "返回生成请求摘要、已选择的模型或能力约束、runtime work handle、等待或完成状态、产物资源 ID 和仍需用户决策的事项。",
  "instructionTemplatePath": "instruction.md",
  "toolGrants": [
    "generation_model_list",
    "generation_image_generate",
    "generation_image_job_get",
    "core_work_start",
    "core_work_get",
    "core_work_list",
    "core_work_wait"
  ]
}
