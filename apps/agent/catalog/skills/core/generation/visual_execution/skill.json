{
  "id": "generation.visual_execution",
  "version": "1.0.0",
  "name": "Visual Generation",
  "description": "在生成目标、参考资源、模型能力和审批边界明确后，提交图片、视频或关键帧生成任务并监控结果。",
  "priority": 780,
  "enabled": true,
  "triggers": [
    {
      "kind": "intent",
      "id": "visual_generation"
    },
    {
      "kind": "keyword",
      "any": [
        "生成图片",
        "生成视频",
        "生成关键帧",
        "关键帧候选",
        "画面锚点候选",
        "关键帧",
        "keyframe generation",
        "keyframe candidate",
        "visual anchor candidate",
        "keyframe_generation",
        "出图",
        "出视频",
        "编辑图片",
        "图片编辑",
        "改图",
        "修图",
        "参考图",
        "这张图",
        "这张图片",
        "让这张",
        "image edit",
        "image_edit",
        "edit image",
        "image generation",
        "video generation"
      ]
    }
  ],
  "toolScope": "intersect",
  "outputContract": "返回任务状态、work/job id、生成类型、模型/provider 信息、可用时的输出资源或媒体预览，以及必要的参数校验说明。",
  "instructionTemplatePath": "instruction.md",
  "toolGrants": [
    "core_user_input_request",
    "generation_model_list",
    "tool_comfyui",
    "tool_webui",
    "core_work_start",
    "core_work_get",
    "core_work_wait",
    "core_work_cancel",
    "core_work_list"
  ]
}
