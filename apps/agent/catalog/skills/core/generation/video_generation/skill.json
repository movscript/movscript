{
  "id": "core.generation.video",
  "version": "1.0.0",
  "name": "Video Generation",
  "description": "Plan, submit, and observe video generation through the agent-owned generation provider interface.",
  "priority": 735,
  "enabled": true,
  "triggers": [
    {
      "kind": "intent",
      "id": "video_generation"
    },
    {
      "kind": "keyword",
      "any": [
        "视频生成",
        "文生视频",
        "图生视频",
        "生成视频",
        "generate video",
        "video generation",
        "text to video",
        "image to video"
      ]
    }
  ],
  "toolScope": "intersect",
  "outputContract": "返回生成请求摘要、已选择的模型或能力约束、runtime work handle、等待或完成状态、产物资源 ID 和仍需用户决策的事项。",
  "instructionTemplatePath": "instruction.md",
  "toolGrants": [
    "generation_model_list",
    "generation_video_generate",
    "generation_video_job_get",
    "core_work_start",
    "core_work_get",
    "core_work_list",
    "core_work_wait"
  ]
}
