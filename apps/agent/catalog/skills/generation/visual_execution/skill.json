{
  "id": "generation.visual_execution",
  "version": "1.0.0",
  "name": "Visual Generation",
  "description": "在生成目标、参考资源、模型能力和审批边界明确后，创建内容单元视觉、关键帧、图片或视频生成任务并监控结果。",
  "priority": 780,
  "enabled": true,
  "triggers": [
    {
      "kind": "intent",
      "id": "visual_generation"
    },
    {
      "kind": "keyword",
      "any": [
        "生成图片",
        "生成视频",
        "生成关键帧",
        "关键帧候选",
        "画面锚点候选",
        "关键帧",
        "keyframe generation",
        "keyframe candidate",
        "visual anchor candidate",
        "keyframe_generation",
        "出图",
        "出视频",
        "编辑图片",
        "图片编辑",
        "改图",
        "修图",
        "参考图",
        "这张图",
        "这张图片",
        "让这张",
        "image edit",
        "image_edit",
        "edit image",
        "image generation",
        "video generation"
      ]
    }
  ],
  "toolScope": "intersect",
  "outputContract": "返回最终任务状态、jobId、生成类型、目标实体、可用时的输出资源列表、一致性参考说明、简洁的匹配理由，以及每个 output_resource_id 的候选集写入结果。",
  "instructionTemplatePath": "instruction.md",
  "toolGrants": [
    "movscript_focus_get",
    "movscript_creative_reference_query",
    "movscript_asset_slot_query",
    "movscript_production_context_query",
    "get_workspace_model",
    "core_user_input_request",
    "generation_model_list",
    "tool_comfyui",
    "tool_webui",
    "core_work_start",
    "core_work_get",
    "core_work_wait",
    "core_work_cancel",
    "candidate_asset_slot_attach",
    "candidate_keyframe_attach",
    "core_work_list"
  ]
}
