{
  "id": "movscript.project_standards_workspace",
  "version": "1.0.0",
  "name": "Project Standards Workspace",
  "description": "打开并编辑 project 层制作规范 workspace：镜头大小体系、画幅、摄影语言、视觉风格、灯光色彩、节奏规则和负面约束。",
  "priority": 900,
  "enabled": true,
  "triggers": [
    {
      "kind": "intent",
      "id": "project_standards_workspace"
    },
    {
      "kind": "keyword",
      "any": [
        "项目规范工作区",
        "项目规范",
        "镜头大小",
        "镜头规格",
        "画幅",
        "风格规范",
        "摄影语言",
        "project standards workspace",
        "project_standards_edit"
      ]
    }
  ],
  "toolScope": "intersect",
  "schemaRefs": [
    "schema://movscript.project_standards_workspace.v1"
  ],
  "instructionTemplatePath": "instruction.md",
  "outputContract": "回复 workspaceId、projectId、剧本依据、项目规范摘要、validation/apply 结果，以及尚未决定的镜头/风格约束。",
  "toolGrants": [
    "movscript_focus_get",
    "movscript_script_locate",
    "get_workspace_model",
    "workspace_open",
    "core_file_read",
    "core_file_search",
    "core_file_edit",
    "workspace_validate",
    "workspace_apply",
    "core_user_input_request"
  ]
}
