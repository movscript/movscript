{
  "id": "movscript.setting_prep",
  "version": "1.0.0",
  "name": "Setting Prep",
  "description": "识别或补齐已选 creative reference 达到 production-ready 所需的最小设定事实。",
  "priority": 760,
  "enabled": true,
  "triggers": [
    {
      "kind": "intent",
      "id": "setting_prep"
    },
    {
      "kind": "keyword",
      "any": [
        "设定准备",
        "设定完善",
        "creative reference"
      ]
    }
  ],
  "toolScope": "intersect",
  "outputContract": "返回改进建议、缺失事实、建议落入的 workspace 字段，以及下一步是否需要 setting_edit 或 asset_edit workspace。",
  "instructionTemplatePath": "instruction.md",
  "toolGrants": [
    "movscript_focus_get",
    "core_user_input_request"
  ]
}
