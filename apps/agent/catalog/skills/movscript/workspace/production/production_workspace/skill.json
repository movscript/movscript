{
  "id": "movscript.production_workspace",
  "version": "1.0.0",
  "name": "Production Workspace",
  "description": "以本地 workspace 的形式编辑 production 层 segment、scene-moment、设定引用和表达条目，并把缺失 project 设定、素材槽或制作颗粒回退到上游 workspace。",
  "priority": 860,
  "enabled": true,
  "triggers": [
    {
      "kind": "intent",
      "id": "production_workspace"
    },
    {
      "kind": "keyword",
      "any": [
        "制作工作区",
        "制作编排",
        "production workspace",
        "production_edit"
      ]
    }
  ],
  "toolScope": "intersect",
  "schemaRefs": [
    "schema://movscript.production_workspace.v1"
  ],
  "outputContract": "回复 workspaceId、projectId、productionId、最近一次 validate/apply 的 ok/stage、segments/scene moments 数量和未解决上游缺口。",
  "instructionTemplatePath": "instruction.md",
  "toolGrants": [
    "movscript_focus_get",
    "get_workspace_model",
    "workspace_open",
    "core_file_read",
    "core_file_search",
    "core_file_edit",
    "workspace_validate",
    "workspace_apply",
    "movscript_creative_reference_query",
    "movscript_asset_slot_query",
    "core_user_input_request"
  ]
}
