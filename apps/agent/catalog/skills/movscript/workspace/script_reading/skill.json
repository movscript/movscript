{
  "id": "movscript.script_reading",
  "version": "1.0.0",
  "name": "Script Reading",
  "description": "读取后端项目剧本 / Script 列表、指定剧本和剧本正文，避免把剧本误判为本地 workspace artifact。",
  "priority": 760,
  "enabled": true,
  "load": "manual",
  "tags": [
    "script",
    "screenplay",
    "剧本",
    "总剧本",
    "分集剧本"
  ],
  "useWhen": [
    "用户要查看、读取、理解、分析或总结后端项目剧本内容",
    "用户提到总剧本、第一集、分集剧本或剧本正文",
    "不要用 asset-workspace、setting-workspace 或本地 workspace task 代替纯剧本读取"
  ],
  "triggers": [
    {
      "kind": "keyword",
      "any": [
        "剧本",
        "总剧本",
        "分集剧本",
        "第一集",
        "查看剧本",
        "读取剧本",
        "script",
        "screenplay"
      ]
    }
  ],
  "toolScope": "intersect",
  "outputContract": "返回已定位或读取的后端剧本版本 ID、标题、只读 ref、行号范围、截断状态和基于工具结果的剧本事实。",
  "instructionTemplatePath": "instruction.md",
  "toolGrants": [
    "movscript_focus_get",
    "movscript_project_list",
    "movscript_script_locate",
    "core_file_read",
    "core_file_search",
    "core_user_input_request"
  ]
}
