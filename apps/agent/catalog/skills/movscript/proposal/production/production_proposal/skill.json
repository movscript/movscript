{
  "id": "movscript.production_proposal",
  "version": "1.0.0",
  "name": "Production Proposal",
  "description": "以本地审阅 draft 的形式起草 production 层 segment、scene-moment、设定引用和表达条目，并把缺失 project 设定、素材槽或制作颗粒回退到上游 proposal。",
  "priority": 860,
  "enabled": true,
  "triggers": [
    {
      "kind": "intent",
      "id": "production_proposal"
    },
    {
      "kind": "keyword",
      "any": [
        "制作提案",
        "制作编排",
        "production proposal",
        "production_proposal"
      ]
    }
  ],
  "toolScope": "intersect",
  "schemaRefs": [
    "schema://movscript.production_proposal.v1"
  ],
  "outputContract": "回复 draftId、projectId、productionId、最近一次 preview_apply 的 ok/stage、segments/scene moments 数量和未解决上游缺口。",
  "instructionTemplatePath": "instruction.md",
  "toolGrants": [
    "movscript_focus_get",
    "draft_model_get",
    "draft_create",
    "core_file_read",
    "core_file_search",
    "core_file_edit",
    "draft_apply_preview",
    "draft_apply",
    "movscript_creative_reference_query",
    "movscript_asset_slot_query",
    "core_user_input_request"
  ]
}
