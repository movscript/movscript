{
  "id": "movscript.setting_proposal",
  "version": "1.0.0",
  "name": "Setting Proposal",
  "description": "起草 project 层设定资料 proposal：人物、地点、道具、产品、风格、世界规则、关系和合并候选。",
  "priority": 905,
  "enabled": true,
  "triggers": [
    {
      "kind": "intent",
      "id": "setting_proposal"
    },
    {
      "kind": "keyword",
      "any": [
        "设定提案",
        "设定资料",
        "人物设定",
        "地点设定",
        "世界观",
        "setting proposal",
        "setting_proposal"
      ]
    }
  ],
  "toolScope": "intersect",
  "schemaRefs": [
    "schema://movscript.setting_proposal.v1"
  ],
  "instructionTemplatePath": "instruction.md",
  "outputContract": "回复 draftId、projectId、validation/preview 结果，以及设定资料变更摘要。",
  "toolGrants": [
    "movscript_focus_get",
    "movscript_script_locate",
    "draft_model_get",
    "draft_create",
    "core_file_read",
    "core_file_search",
    "core_file_edit",
    "draft_apply_preview",
    "draft_apply",
    "core_user_input_request"
  ]
}
