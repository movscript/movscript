{
  "id": "movscript.project_standards_proposal",
  "version": "1.0.0",
  "name": "Project Standards Proposal",
  "description": "起草 project 层制作规范：镜头大小体系、画幅、摄影语言、视觉风格、灯光色彩、节奏规则和负面约束。",
  "priority": 900,
  "enabled": true,
  "triggers": [
    {
      "kind": "intent",
      "id": "project_standards_proposal"
    },
    {
      "kind": "keyword",
      "any": [
        "项目规范提案",
        "项目规范",
        "镜头大小",
        "镜头规格",
        "画幅",
        "风格规范",
        "摄影语言",
        "project standards proposal",
        "project_standards_proposal"
      ]
    }
  ],
  "toolScope": "intersect",
  "schemaRefs": [
    "schema://movscript.project_standards_proposal.v1"
  ],
  "instructionTemplatePath": "instruction.md",
  "outputContract": "回复 draftId、projectId、剧本依据、项目规范摘要、validation 结果，以及尚未决定的镜头/风格约束。",
  "toolGrants": [
    "movscript_focus_get",
    "movscript_script_locate",
    "draft_model_get",
    "draft_create",
    "core_file_read",
    "core_file_search",
    "core_file_edit",
    "draft_apply_preview",
    "draft_apply",
    "core_user_input_request"
  ]
}
