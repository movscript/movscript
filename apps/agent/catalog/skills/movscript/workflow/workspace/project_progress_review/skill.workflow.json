{
  "id": "movscript.workflow.project_progress_review",
  "kind": "workflow",
  "version": "1.0.0",
  "name": "Project Progress",
  "description": "根据已验证上下文、剧本、drafts 和可用状态总结当前项目或 production 进度。",
  "priority": 660,
  "enabled": true,
  "triggers": [
    {
      "kind": "keyword",
      "any": [
        "进度",
        "完成度",
        "project progress",
        "status"
      ]
    }
  ],
  "toolRefs": [
    "tool://movscript_focus_get",
    "tool://movscript_project_script_read",
    "tool://draft_get"
  ],
  "toolScope": "intersect",
  "outputContract": "返回已验证进度、未关闭 drafts、阻塞项、未知项和推荐下一步 workflow。",
  "instructionTemplatePath": "instruction.md"
}
