{
  "id": "movscript.workflow.content_unit_proposal",
  "kind": "workflow",
  "version": "1.0.0",
  "name": "Content Unit Proposal",
  "description": "以本地审阅 draft 形式起草内容单元结构、剧情推进、情绪推进、钩子和节拍 proposal。",
  "priority": 830,
  "enabled": true,
  "triggers": [
    {
      "kind": "intent",
      "id": "content_unit_proposal"
    },
    {
      "kind": "keyword",
      "any": [
        "内容单元",
        "分镜",
        "镜头参数",
        "视觉计划",
        "视觉调度",
        "调度图",
        "blocking",
        "storyboard brief",
        "导演分镜",
        "普通导演",
        "content unit",
        "content_unit_proposal"
      ]
    }
  ],
  "toolRefs": [
    "tool://movscript_focus_get",
    "tool://movscript_production_context_query",
    "tool://movscript_creative_reference_query",
    "tool://movscript_asset_slot_query",
    "tool://draft_create",
    "tool://core_file_read",
    "tool://core_file_search",
    "tool://core_file_edit",
    "tool://draft_apply_preview",
    "tool://draft_apply",
    "tool://knowledge_search",
    "tool://knowledge_get",
    "tool://core_user_input_request"
  ],
  "toolScope": "intersect",
  "schemaRefs": [
    "schema://movscript.content_unit_proposal.v1"
  ],
  "outputContract": "返回 draftId、productionId、content unit 数量、validation/preview 状态、结构缺口和下一步媒体或素材工作建议。",
  "metadata": {
    "expertiseRefs": [
      "film.expertise.storyboard.director"
    ]
  },
  "instructionTemplatePath": "instruction.md"
}
