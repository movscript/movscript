{
  "id": "candidate.asset_planning",
  "version": "1.0.0",
  "name": "Asset Candidate Execution",
  "description": "消费 asset_edit workspace 中已明确的候选制作方案，创建并监控可审阅的图片或视频候选，并在成功后加入候选集。",
  "priority": 770,
  "enabled": true,
  "triggers": [
    {
      "kind": "intent",
      "id": "asset_candidate_generation"
    },
    {
      "kind": "keyword",
      "any": [
        "生成素材",
        "生成候选",
        "生成图片候选",
        "生成视频候选",
        "asset candidate"
      ]
    }
  ],
  "toolScope": "intersect",
  "outputContract": "返回已选 asset target、候选 prompt 方向、已有设定/素材检查结果、所需模型能力、生成 workId、output_resource_id 列表、每个 output_resource_id 的候选写入结果、阻塞项和下一步动作。",
  "instructionTemplatePath": "instruction.md",
  "toolGrants": [
    "movscript_focus_get",
    "movscript_creative_reference_query",
    "movscript_asset_slot_query",
    "movscript_production_context_query",
    "get_workspace_model",
    "core_user_input_request",
    "generation_model_list",
    "core_work_start",
    "core_work_get",
    "core_work_wait",
    "core_work_list",
    "candidate_asset_slot_attach",
    "core_work_cancel"
  ]
}
