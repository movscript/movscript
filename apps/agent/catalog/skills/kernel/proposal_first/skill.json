{
  "id": "kernel.proposal_first",
  "version": "1.0.0",
  "name": "Proposal First",
  "description": "在正式写入前，把宽泛、跨层或缺上游上下文的请求路由到最小必要的本地 proposal draft。",
  "priority": 700,
  "enabled": true,
  "triggers": [
    {
      "kind": "keyword",
      "any": [
        "提案",
        "草稿",
        "proposal",
        "draft"
      ]
    }
  ],
  "toolScope": "intersect",
  "outputContract": "返回已选择的 draft 或推荐的 draft kind、选择理由、阻塞项、下一步审阅动作和应交接的 task。",
  "instructionTemplatePath": "instruction.md",
  "toolGrants": [
    "movscript_focus_get",
    "draft_create",
    "core_file_read",
    "core_file_search",
    "core_file_edit",
    "draft_apply_preview",
    "draft_apply",
    "core_user_input_request"
  ]
}
