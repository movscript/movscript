{
  "id": "draft.workflow.lifecycle",
  "kind": "workflow",
  "version": "1.0.0",
  "name": "Draft Lifecycle",
  "description": "通用本地 draft 读取、创建、编辑、dry-run preview 和汇报流程；preview 内置 validation。",
  "priority": 740,
  "enabled": true,
  "triggers": [
    {
      "kind": "keyword",
      "any": [
        "draft",
        "草稿",
        "提案",
        "审阅",
        "修改草稿",
        "validate",
        "preview",
        "preview_apply",
        "apply"
      ]
    }
  ],
  "toolRefs": [
    "tool://draft_model_get",
    "tool://core_file_read",
    "tool://core_file_search",
    "tool://core_file_edit",
    "tool://draft_create",
    "tool://draft_apply_preview",
    "tool://draft_apply",
    "tool://core_user_input_request"
  ],
  "toolScope": "intersect",
  "outputContract": "返回 draftId、kind、status、是否读取过现有 draft、validation/preview 状态，以及下一步 review 或 apply 动作。",
  "instructionTemplatePath": "instruction.md"
}
