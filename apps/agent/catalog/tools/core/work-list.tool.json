{
  "name": "core_work_list",
  "description": "列出当前 run 的 runtime works。runId:'all' 可查看 runtime 内所有 work。不要用于普通同步工具调用。",
  "permission": "agent.work.read",
  "risk": "read",
  "source": "runtime",
  "category": "runtime-work",
  "allowedRunRoles": ["planner"],
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "runId": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": ["queued", "running", "waiting", "completed", "failed", "cancelled", "timeout"]
      }
    }
  }
}
