{
  "name": "core_work_wait",
  "description": "观察一个或多个 runtime works 的最新状态，并可选择短暂等待终态；未完成时也会立即返回当前状态，work 会继续在后台运行。支持 all/any 模式。普通同步工具调用不需要 wait。",
  "permission": "agent.work.read",
  "risk": "read",
  "source": "runtime",
  "category": "runtime-work",
  "allowedRunRoles": ["planner"],
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["workIds"],
    "properties": {
      "workIds": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 1
      },
      "mode": {
        "type": "string",
        "enum": ["all", "any"]
      },
      "timeoutMs": {
        "type": "number"
      },
      "pollIntervalMs": {
        "type": "number"
      }
    }
  }
}
