{
  "name": "core_image_tile",
  "description": "本地将图片资源切成多个优化后的 tile，并把 tile 图片作为下一轮模型 image parts 发送。适合系统查看大图、长截图、密集 UI 或需要广覆盖细节扫描的图片。",
  "permission": "agent.media.read",
  "risk": "read",
  "source": "runtime",
  "category": "media",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "resourceId": { "type": "number", "minimum": 1, "description": "图片资源 ID。" },
      "resource_id": { "type": "number", "minimum": 1, "description": "resourceId 的别名。" },
      "dataUrl": { "type": "string", "description": "图片 data URL，仅在没有 resourceId 时使用。" },
      "data_url": { "type": "string", "description": "dataUrl 的别名。" },
      "columns": { "type": "number", "minimum": 1, "maximum": 8, "description": "按列数切图；与 rows 一起使用可精确控制网格。" },
      "rows": { "type": "number", "minimum": 1, "maximum": 8, "description": "按行数切图；与 columns 一起使用可精确控制网格。" },
      "tileSize": { "type": "number", "minimum": 128, "maximum": 4096, "description": "未指定 columns/rows 时，用该尺寸估算 tile 网格。默认 1024。" },
      "tile_size": { "type": "number", "minimum": 128, "maximum": 4096, "description": "tileSize 的别名。" },
      "maxTiles": { "type": "number", "minimum": 1, "maximum": 16, "description": "本次最多发送多少个 tile；默认 8，最大 16。" },
      "max_tiles": { "type": "number", "minimum": 1, "maximum": 16, "description": "maxTiles 的别名。" },
      "preset": {
        "type": "string",
        "enum": ["vision_default", "vision_detail", "ui_screenshot", "thumbnail"],
        "description": "tile 输出预设。默认 vision_detail。"
      },
      "maxDimension": { "type": "number", "minimum": 128, "maximum": 4096, "description": "每个 tile 输出图片最长边像素。" },
      "max_dimension": { "type": "number", "minimum": 128, "maximum": 4096, "description": "maxDimension 的别名。" },
      "format": { "type": "string", "enum": ["jpeg", "png", "webp"], "description": "输出格式。" },
      "quality": { "type": "number", "minimum": 1, "maximum": 100, "description": "输出质量，主要用于 jpeg/webp。" },
      "name": { "type": "string", "description": "源图片名称。" },
      "mimeType": { "type": "string", "description": "源图片 MIME 类型。" },
      "mime_type": { "type": "string", "description": "mimeType 的别名。" }
    },
    "anyOf": [
      { "required": ["resourceId"] },
      { "required": ["resource_id"] },
      { "required": ["dataUrl"] },
      { "required": ["data_url"] }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true,
    "required": ["status", "source", "image", "tile_count", "tiles"],
    "properties": {
      "status": { "type": "string", "const": "tiled" },
      "source": { "type": "object" },
      "image": { "type": "object" },
      "tile_count": { "type": "number" },
      "omitted_count": { "type": "number" },
      "tiles": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true,
          "required": ["index", "row", "column", "crop", "output"],
          "properties": {
            "index": { "type": "number" },
            "row": { "type": "number" },
            "column": { "type": "number" },
            "crop": { "type": "object" },
            "output": {
              "type": "object",
              "additionalProperties": true,
              "required": ["width", "height", "mimeType", "sizeBytes", "image_payload"],
              "properties": {
                "width": { "type": "number" },
                "height": { "type": "number" },
                "mimeType": { "type": "string" },
                "sizeBytes": { "type": "number" },
                "image_payload": { "type": "string", "const": "sent_to_model_as_image_part" }
              }
            }
          }
        }
      }
    }
  },
  "projectScoped": false,
  "defaults": {
    "grant": "allow",
    "approval": "never"
  },
  "capability": "本地把大图切成多个优化 tile 并发送给 vision 模型；默认不发送原图。"
}
