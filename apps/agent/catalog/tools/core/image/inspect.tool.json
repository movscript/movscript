{
  "name": "core_image_inspect",
  "description": "本地读取用户图片或后端图片资源，返回尺寸、格式、颜色空间等元数据。原始图片不会发送给模型；仅用于判断是否需要裁剪、放大细节或重新预处理。",
  "permission": "agent.media.read",
  "risk": "read",
  "source": "runtime",
  "category": "media",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "resourceId": {
        "type": "number",
        "minimum": 1,
        "description": "图片资源 ID。"
      },
      "resource_id": {
        "type": "number",
        "minimum": 1,
        "description": "resourceId 的别名。"
      },
      "dataUrl": {
        "type": "string",
        "description": "图片 data URL，仅在没有 resourceId 时使用。"
      },
      "data_url": {
        "type": "string",
        "description": "dataUrl 的别名。"
      }
    },
    "anyOf": [
      { "required": ["resourceId"] },
      { "required": ["resource_id"] },
      { "required": ["dataUrl"] },
      { "required": ["data_url"] }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true,
    "required": ["source", "image"],
    "properties": {
      "source": { "type": "object" },
      "image": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "width": { "type": "number" },
          "height": { "type": "number" },
          "format": { "type": "string" },
          "mimeType": { "type": "string" },
          "sizeBytes": { "type": "number" }
        }
      }
    }
  },
  "projectScoped": false,
  "defaults": {
    "grant": "allow",
    "approval": "never"
  },
  "capability": "本地检查图片资源元数据，帮助决定是否需要发送细节图、裁剪图或缩略图。"
}
