{
  "name": "core_image_preprocess",
  "description": "本地将图片资源预处理为适合 vision 模型理解的优化图片，可指定细节等级、最大边长、格式和质量。工具结果不会包含 base64；优化后的图片会作为下一轮模型 image part 发送。",
  "permission": "agent.media.read",
  "risk": "read",
  "source": "runtime",
  "category": "media",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "resourceId": { "type": "number", "minimum": 1, "description": "图片资源 ID。" },
      "resource_id": { "type": "number", "minimum": 1, "description": "resourceId 的别名。" },
      "dataUrl": { "type": "string", "description": "图片 data URL，仅在没有 resourceId 时使用。" },
      "data_url": { "type": "string", "description": "dataUrl 的别名。" },
      "preset": {
        "type": "string",
        "enum": ["vision_default", "vision_detail", "ui_screenshot", "thumbnail"],
        "description": "预处理预设。默认 vision_default；需要看清小字或细节时用 vision_detail；界面截图可用 ui_screenshot。"
      },
      "maxDimension": { "type": "number", "minimum": 128, "maximum": 4096, "description": "输出图片最长边像素。" },
      "max_dimension": { "type": "number", "minimum": 128, "maximum": 4096, "description": "maxDimension 的别名。" },
      "format": { "type": "string", "enum": ["jpeg", "png", "webp"], "description": "输出格式。" },
      "quality": { "type": "number", "minimum": 1, "maximum": 100, "description": "输出质量，主要用于 jpeg/webp。" },
      "name": { "type": "string", "description": "源图片名称。" },
      "mimeType": { "type": "string", "description": "源图片 MIME 类型。" },
      "mime_type": { "type": "string", "description": "mimeType 的别名。" }
    },
    "anyOf": [
      { "required": ["resourceId"] },
      { "required": ["resource_id"] },
      { "required": ["dataUrl"] },
      { "required": ["data_url"] }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true,
    "required": ["source", "original", "output", "preset"],
    "properties": {
      "source": { "type": "object" },
      "original": { "type": "object" },
      "preset": { "type": "string" },
      "output": {
        "type": "object",
        "additionalProperties": true,
        "required": ["width", "height", "mimeType", "sizeBytes", "image_payload"],
        "properties": {
          "width": { "type": "number" },
          "height": { "type": "number" },
          "mimeType": { "type": "string" },
          "sizeBytes": { "type": "number" },
          "image_payload": { "type": "string", "const": "sent_to_model_as_image_part" }
        }
      }
    }
  },
  "projectScoped": false,
  "defaults": {
    "grant": "allow",
    "approval": "never"
  },
  "capability": "本地压缩、缩放和转码图片，再把优化后的图片作为 vision 输入发给模型；默认不发送原图。"
}
