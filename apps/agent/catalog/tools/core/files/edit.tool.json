{
  "name": "core_file_edit",
  "description": "编辑 agent 文件系统中的文本对象。调用前应先 core_file_read 获取 revision，并把该 revision 作为 baseRevision 传入以避免覆盖并发修改。返回 changeSet 记录本次 edit。只读 MCP resource 不可编辑。",
  "permission": "agent.file.write",
  "risk": "workspace",
  "source": "runtime",
  "category": "files",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["ref"],
    "anyOf": [
      { "required": ["edits"] },
      { "required": ["patch"] }
    ],
    "properties": {
      "ref": {
        "type": "string",
        "description": "canonical 文件引用，例如 agent://workspace/{workspaceId}/content。"
      },
      "baseRevision": {
        "type": "string",
        "description": "从 core_file_read 得到的 revision。提供后必须与当前文件 revision 一致。"
      },
      "patch": {
        "type": "string",
        "description": "可选，受限上下文文本 patch。必须以 *** Begin Patch 开始、以 *** End Patch 结束；只能包含 *** Update File: content 和 @@ hunk；hunk 行只能以空格、- 或 + 开头。工具会把空格/- 行组成 oldText，把空格/+ 行组成 newText，并要求 oldText 在当前文件全文中精确匹配一次后才写入。它不是 JSON Patch、不是通用 unified diff，也不会理解 JSON 语义；如果报 found > 1，说明上下文不唯一，必须读取更大范围并把父级字段、相邻数组边界或后续唯一字段纳入 hunk，不能原样重试。不能与 edits 同时传。"
      },
      "edits": {
        "type": "array",
        "minItems": 1,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "patch"],
              "properties": {
                "type": { "const": "apply_patch" },
                "patch": { "type": "string" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "oldText", "newText"],
              "properties": {
                "type": { "const": "replace_text" },
                "oldText": { "type": "string" },
                "newText": { "type": "string" },
                "replaceAll": { "type": "boolean" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "content"],
              "properties": {
                "type": { "const": "set_content" },
                "content": { "type": "string" }
              }
            }
          ]
        }
      }
    }
  }
}
