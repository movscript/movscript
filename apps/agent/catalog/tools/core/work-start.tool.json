{
  "name": "core_work_start",
  "description": "提交一个可等待的异步 runtime work，并立即返回 work handle；本工具不等待后端或子 agent 完成，也不代表最终成功。普通同步工具直接调用，不要通过此工具包装。支持 kind:\"generation_job\" 和 kind:\"subagent_run\"；后续状态和结果通过 core_work_get/list/wait/cancel 观察或管理。",
  "permission": "agent.work.write",
  "risk": "generate",
  "source": "runtime",
  "category": "runtime-work",
  "allowedRunRoles": ["planner"],
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["kind", "request"],
    "properties": {
      "kind": {
        "type": "string",
        "enum": ["generation_job", "subagent_run"]
      },
      "request": {
        "type": "object",
        "description": "work provider 原始请求。generation_job 使用后端生成任务参数；subagent_run 使用子 agent 任务说明、期望输出、写入边界和可选权限配置。"
      },
      "timeoutMs": {
        "type": "number"
      },
      "pollIntervalMs": {
        "type": "number"
      },
      "continuationPolicy": {
        "type": "object",
        "description": "后台续跑策略。推荐传 {\"mode\":\"any_completed\",\"groupId\":\"同一批 work 共享的稳定组 ID\"}，runtime 会在 work 完成且线程无阻塞工作时自动创建 continuation run。",
        "additionalProperties": false,
        "required": ["mode"],
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["none", "any_completed", "all_completed", "all_settled", "manual_selection"]
          },
          "groupId": {
            "type": "string"
          },
          "group_id": {
            "type": "string"
          }
        }
      },
      "continuation_policy": {
        "type": "object",
        "description": "continuationPolicy 的 snake_case 别名。",
        "additionalProperties": false,
        "required": ["mode"],
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["none", "any_completed", "all_completed", "all_settled", "manual_selection"]
          },
          "groupId": {
            "type": "string"
          },
          "group_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
