{
  "name": "get_workspace_model",
  "description": "读取 frontend WorkspaceModel 契约，用于检查字段归属、seed policy、validation effects、save/apply boundary，或显式查看按目标 hydrate 的当前初始内容。workspace_open 在缺少 content 时也使用同一 MCP contract 生成初始内容。",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "kind"
    ],
    "properties": {
      "kind": {
        "type": "string",
        "description": "业务 workspace kind。具体可用值和字段语义由前端 MCP contract 决定。"
      },
      "target": {
        "type": "object",
        "additionalProperties": true
      },
      "seedMode": {
        "type": "string",
        "enum": [
          "empty",
          "snapshot",
          "editable_snapshot"
        ]
      },
      "include": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "hydrate": {
        "type": "boolean"
      }
    }
  },
  "permission": "project.read",
  "risk": "read",
  "projectScoped": false,
  "defaults": {
    "grant": "allow",
    "approval": "never"
  },
  "source": "runtime",
  "outputSchema": {
    "type": "object",
    "additionalProperties": true,
    "required": [
      "contractVersion",
      "kind",
      "targetEntityType",
      "target",
      "seedPolicy",
      "workspaceProtocol",
      "initialContent",
      "fieldGuide",
      "applyBoundary",
      "modelRef"
    ],
    "properties": {
      "contractVersion": { "type": "number" },
      "kind": { "type": "string" },
      "title": { "type": "string" },
      "targetEntityType": { "type": "string" },
      "target": { "type": "object", "additionalProperties": true },
      "seedPolicy": { "type": "object", "additionalProperties": true },
      "seed": { "type": "object", "additionalProperties": true },
      "workspaceProtocol": { "type": "object", "additionalProperties": true },
      "initialContent": { "type": "object", "additionalProperties": true },
      "initialContentText": { "type": "string" },
      "contentSchemaId": { "type": "string" },
      "contentSchema": { "type": "object", "additionalProperties": true },
      "fieldGuide": { "type": "object", "additionalProperties": true },
      "applyBoundary": { "type": "object", "additionalProperties": true },
      "reviewRouteTemplate": { "type": "string" },
      "reviewRoute": { "type": "string" },
      "modelRef": { "type": "string" }
    }
  },
  "capability": "从前端 MCP 单一模型源读取 workspace 语义、初始内容、seed、validation/save 协议和保存边界契约。"
}
