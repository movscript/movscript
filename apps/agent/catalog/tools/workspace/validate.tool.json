{
  "name": "workspace_validate",
  "description": "校验当前 workspace 内容。该工具会先校验真实 workspace 文件内容；支持的编辑 kind 会调用后端 preview/validation，但不会正式保存。",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "workspaceId"
    ],
    "properties": {
      "workspaceId": {
        "type": "string"
      },
      "target": {
        "type": "object",
        "additionalProperties": true
      },
      "targetEntityType": {
        "type": "string"
      },
      "targetEntityId": {
        "type": [
          "string",
          "number"
        ]
      },
      "targetField": {
        "type": "string"
      },
      "currentValue": {},
      "proposedValue": {}
    }
  },
  "permission": "workspace.read",
  "risk": "read",
  "projectScoped": false,
  "defaults": {
    "grant": "allow",
    "approval": "never"
  },
  "source": "runtime",
  "capability": "对当前 workspace 做 validation；正文由真实文件编辑工具负责。"
}
