{
  "name": "workspace_apply",
  "description": "应用已校验通过的 workspace 当前内容。该工具会执行现有后端写入/update 路径；workspace 本身保持可继续编辑，后续修改后可以再次应用。",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "workspaceId"
    ],
    "properties": {
      "workspaceId": {
        "type": "string"
      },
      "target": {
        "type": "object",
        "additionalProperties": true
      },
      "targetEntityType": {
        "type": "string"
      },
      "targetEntityId": {
        "type": [
          "string",
          "number"
        ]
      },
      "targetField": {
        "type": "string"
      },
      "currentValue": {},
      "proposedValue": {},
      "appliedByUserId": {
        "type": [
          "string",
          "number"
        ]
      }
    }
  },
  "permission": "workspace.apply",
  "risk": "write",
  "projectScoped": false,
  "defaults": {
    "grant": "allow",
    "approval": "on_write"
  },
  "source": "runtime",
  "capability": "对已校验通过的 workspace 当前内容执行应用。"
}
