{
  "name": "reference_get",
  "description": "按本地文本参考 id 读取正文，并按 maxChars 截断。",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "maxChars": {
        "type": "number",
        "minimum": 1,
        "maximum": 12000
      }
    }
  },
  "permission": "reference.read",
  "risk": "read",
  "projectScoped": false,
  "defaults": {
    "grant": "allow",
    "approval": "never"
  },
  "source": "runtime",
  "capability": "读取本地 text reference 正文；外部图片、视频和镜头库结果通常由 reference_search 直接返回完整可用摘要。"
}
