{
  "name": "generation_model_list",
  "description": "List enabled generation models for a runtime capability. Use image for text-to-image, image_edit for image-to-image, video for text-to-video, video_i2v for image-to-video, and video_v2v for video-to-video. The result includes public model_id values and model_contracts so the agent can choose valid provider parameters before starting generation work.",
  "permission": "generation.model.read",
  "risk": "read",
  "source": "mcp",
  "capability": "generation.model.list",
  "projectScoped": false,
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "capability": { "type": "string" },
      "provider_variants": { "type": "boolean" },
      "include_provider_variants": { "type": "boolean" }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true,
    "required": ["count", "queries", "model_contracts", "models"],
    "properties": {
      "count": { "type": "number" },
      "queries": { "type": "array", "items": { "type": "string" } },
      "model_contracts": { "type": "array" },
      "models": { "type": "array" }
    }
  },
  "defaults": { "grant": "allow", "approval": "never" },
  "execution": {
    "readOnly": true,
    "destructive": false,
    "concurrencySafe": true,
    "interruptBehavior": "block",
    "resultRefStrategy": "summary_ref"
  }
}
