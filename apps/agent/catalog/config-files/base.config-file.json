{
  "schema": "movscript.agent.config_file.v1",
  "id": "movscript.config_file.base",
  "version": "1.0.0",
  "name": "MovScript Base Config File",
  "description": "基础 Agent 配置文件，只启用通用 core 和 workspace 能力；生成能力由已安装的 image/video 插件提供。",
  "enabledPackIds": [
    "core.pack.agent",
    "generation.pack.media",
    "workspace.pack.lifecycle"
  ],
  "skillIds": [
    "core.base.default",
    "core.rules.runtime",
    "core.memory_access",
    "core.subagent_planning",
    "core.generation.image",
    "core.generation.video",
    "workspace.lifecycle_support"
  ],
  "toolGrants": [
    { "name": "core_file_read", "mode": "allow", "approval": "never" },
    { "name": "core_file_search", "mode": "allow", "approval": "never" },
    { "name": "core_file_edit", "mode": "allow", "approval": "never" },
    { "name": "core_image_inspect", "mode": "allow", "approval": "never" },
    { "name": "core_image_preprocess", "mode": "allow", "approval": "never" },
    { "name": "core_image_crop", "mode": "allow", "approval": "never" },
    { "name": "core_image_tile", "mode": "allow", "approval": "never" },
    { "name": "get_workspace_model", "mode": "allow", "approval": "never" },
    { "name": "workspace_open", "mode": "allow", "approval": "never" },
    { "name": "workspace_validate", "mode": "allow", "approval": "never" },
    { "name": "workspace_apply", "mode": "allow", "approval": "on_write" },
    { "name": "core_memory_search", "mode": "allow", "approval": "never" },
    { "name": "core_memory_get", "mode": "allow", "approval": "never" },
    { "name": "core_memory_create", "mode": "allow", "approval": "never" },
    { "name": "core_memory_delete", "mode": "allow", "approval": "never" },
    { "name": "core_catalog_inspect", "mode": "allow", "approval": "never" },
    { "name": "core_skill_update", "mode": "allow", "approval": "never" },
    { "name": "core_update_plan", "mode": "allow", "approval": "never" },
    { "name": "core_work_start", "mode": "allow", "approval": "always" },
    { "name": "core_work_get", "mode": "allow", "approval": "never" },
    { "name": "core_work_list", "mode": "allow", "approval": "never" },
    { "name": "core_work_wait", "mode": "allow", "approval": "never" },
    { "name": "core_work_cancel", "mode": "allow", "approval": "always" },
    { "name": "core_user_input_request", "mode": "allow", "approval": "never" }
  ],
  "limits": {
    "maxActiveTriggeredSkills": 2,
    "systemPromptCharLimit": 32000,
    "contextWindowCharLimit": 96000,
    "maxRetrievedContextChars": 24000,
    "maxReferenceCharsPerRun": 8000,
    "maxReferenceChunksPerRun": 3,
    "maxHistoryMessages": 6,
    "maxThreadSummaryChars": 4000
  },
  "metadata": {
    "promptOptions": {
      "finalSourceBlock": true
    }
  }
}
