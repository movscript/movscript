{
  "schema": "movscript.agent.profile.v1",
  "id": "movscript.profile.default",
  "version": "1.0.0",
  "name": "MovScript Default Profile",
  "description": "默认 MovScript agent profile，显式启用 core、draft 和 MovScript capability packs。",
  "enabledPacks": [
    "core.pack.agent",
    "draft.pack.lifecycle",
    "movscript.pack.workspace"
  ],
  "persona": "core.persona.default",
  "enabledWorkflows": [
    "core.workflow.memory_access",
    "core.workflow.subagent_planning",
    "draft.workflow.lifecycle",
    "movscript.workflow.project_progress_review",
    "movscript.workflow.script_reading",
    "kernel.workflow.proposal_first",
    "movscript.workflow.project_standards_proposal",
    "movscript.workflow.setting_proposal",
    "movscript.workflow.asset_proposal",
    "movscript.workflow.setting_prep",
    "movscript.workflow.production_proposal",
    "candidate.workflow.asset_planning",
    "movscript.workflow.content_unit_proposal",
    "movscript.workflow.storyboard_gap_review",
    "generation.workflow.visual_execution"
  ],
  "enabledPolicies": [
    "core.policy.runtime"
  ],
  "toolGrants": [
    { "name": "movscript_focus_get", "mode": "allow", "approval": "never" },
    { "name": "movscript_project_list", "mode": "allow", "approval": "never" },
    { "name": "movscript_project_standards_get", "mode": "allow", "approval": "never" },
    { "name": "movscript_project_script_read", "mode": "allow", "approval": "never" },
    { "name": "movscript_creative_reference_query", "mode": "allow", "approval": "never" },
    { "name": "movscript_asset_slot_query", "mode": "allow", "approval": "never" },
    { "name": "movscript_production_context_query", "mode": "allow", "approval": "never" },
    { "name": "generation_model_list", "mode": "allow", "approval": "never" },
    { "name": "tool_comfyui", "mode": "allow", "approval": "always" },
    { "name": "tool_webui", "mode": "allow", "approval": "always" },
    { "name": "candidate_asset_slot_attach", "mode": "allow", "approval": "never" },
    { "name": "candidate_keyframe_attach", "mode": "allow", "approval": "never" },
    { "name": "knowledge_search", "mode": "allow", "approval": "never" },
    { "name": "knowledge_get", "mode": "allow", "approval": "never" },
    { "name": "draft_get", "mode": "allow", "approval": "never" },
    { "name": "draft_file_read", "mode": "allow", "approval": "never" },
    { "name": "draft_file_search", "mode": "allow", "approval": "never" },
    { "name": "draft_file_edit", "mode": "allow", "approval": "never" },
    { "name": "draft_file_validate", "mode": "allow", "approval": "never" },
    { "name": "draft_model_get", "mode": "allow", "approval": "never" },
    { "name": "draft_create", "mode": "allow", "approval": "never" },
    { "name": "draft_validate", "mode": "allow", "approval": "never" },
    { "name": "draft_apply_preview", "mode": "allow", "approval": "never" },
    { "name": "draft_apply", "mode": "allow", "approval": "on_write" },
    { "name": "core_memory_search", "mode": "allow", "approval": "never" },
    { "name": "core_memory_get", "mode": "allow", "approval": "never" },
    { "name": "core_memory_create", "mode": "allow", "approval": "never" },
    { "name": "core_memory_delete", "mode": "allow", "approval": "never" },
    { "name": "core_catalog_inspect", "mode": "allow", "approval": "never" },
    { "name": "core_skill_update", "mode": "allow", "approval": "never" },
    { "name": "core_subagent_spawn", "mode": "allow", "approval": "never" },
    { "name": "core_subagent_list", "mode": "allow", "approval": "never" },
    { "name": "core_subagent_wait", "mode": "allow", "approval": "never" },
    { "name": "core_subagent_cancel", "mode": "allow", "approval": "never" },
    { "name": "core_operation_start", "mode": "allow", "approval": "always" },
    { "name": "core_operation_get", "mode": "allow", "approval": "never" },
    { "name": "core_operation_list", "mode": "allow", "approval": "never" },
    { "name": "core_operation_wait", "mode": "allow", "approval": "never" },
    { "name": "core_operation_cancel", "mode": "allow", "approval": "always" },
    { "name": "core_user_input_request", "mode": "allow", "approval": "never" }
  ],
  "limits": {
    "maxActiveWorkflows": 2,
    "systemPromptCharLimit": 32000,
    "contextWindowCharLimit": 96000,
    "maxRetrievedContextChars": 24000,
    "maxKnowledgeCharsPerRun": 8000,
    "maxKnowledgeChunksPerRun": 3,
    "maxHistoryMessages": 6,
    "maxThreadSummaryChars": 4000
  },
  "metadata": {
    "promptPolicy": {
      "projectStandards": {
        "mode": "required_for_project_work"
      },
      "finalSourceBlock": true
    }
  }
}
